# ==========================================
# تنظیمات محیطی سامانه هوش مصنوعی AradGPT Pro
# ==========================================

# 1. ارائه‌دهنده فعال سیستم (ACTIVE_PROVIDER)
# گزینه‌ها: openrouter | gapgpt | openai | deepseek | groq | custom
ACTIVE_PROVIDER=openrouter

# 2. کلید دسترسی API (API Key)
# برای OpenRouter: کلید خود را از openrouter.ai دریافت و اینجا قرار دهید (با sk-or-v1 شروع می‌شود)
# برای GapGPT: کلید را از api.gapgpt.app دریافت کنید
# برای OpenAI: کلید sk-... رسمی
AI_API_KEY=your_api_key_here

# 3. آدرس سرور API (Base URL)
# در صورت تمایل به تغییر دستی آدرس ارائه‌دهنده
# OpenRouter: https://openrouter.ai/api/v1
# GapGPT: https://api.gapgpt.app/v1
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Groq: https://api.groq.com/openai/v1
# Custom / Ollama Local: http://localhost:11434/v1
AI_BASE_URL=https://openrouter.ai/api/v1

# 4. نرخ تبدیل دلار به تومان (برای محاسبه دقیق هزینه توکن‌ها)
USD_TO_TOMAN=85000

# 5. شارژ هدیه خوش‌آمدگویی برای کاربران تازه ثبت‌نام کرده (به تومان)
WELCOME_BONUS=20000

# 6. عنوان سامانه
APP_TITLE=AradGPT Pro

# کلیدهای سازگاری پیشین (در صورت استفاده از GapGPT یا OpenAI اختصاصی)
# GAP_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
