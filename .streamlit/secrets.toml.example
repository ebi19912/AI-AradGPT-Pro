# .streamlit/secrets.toml
# نمونه فایل کلیدهای مخفی سامانه AradGPT Pro

# ارائه‌دهنده فعال: openrouter | gapgpt | openai | deepseek | groq | custom
ACTIVE_PROVIDER = "openrouter"

# کلید اصلی API هوش مصنوعی (OpenRouter, GapGPT, OpenAI, ...)
AI_API_KEY = "sk-or-v1-your_api_key_here"

# آدرس پایه API (اختیاری - در صورت تمایل به تغییر آدرس پیش‌فرض)
# AI_BASE_URL = "https://openrouter.ai/api/v1"

# نرخ دلار به تومان (اختیاری)
# USD_TO_TOMAN = 85000

# متغیرهای قدیمی سازگار
# GAP_API_KEY = "your_gapgpt_api_key"
