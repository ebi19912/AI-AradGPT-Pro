[Unit]
Description=AradGPT Pro FastAPI AI SaaS Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/AI-AradGPT-Pro
ExecStart=/var/www/AI-AradGPT-Pro/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8501
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8

[Install]
WantedBy=multi-user.target
